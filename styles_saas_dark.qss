/* ============================================================================
   PDF Print Manager - PREMIUM SAAS DARK MODE
   Modern SaaS Application Design
   Author: Eng. Justo Torres
   ============================================================================ */

/* ============================================================================
   ROOT & MAIN WINDOW - Pure Dark Background
   ============================================================================ */
* {
    font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    outline: none;
}

QMainWindow {
    background: #0D0E12;
}

/* ============================================================================
   SIDEBAR - Clean Separation
   ============================================================================ */
#sidebar {
    background: #0F111A;
    border: none;
    border-right: 1px solid #1E2235;
    min-width: 320px;
    max-width: 320px;
}

#sidebarTitle {
    color: #FFFFFF;
    font-size: 34px;
    font-weight: 900;
    padding: 40px 28px 6px 28px;
    letter-spacing: -1px;
}

#sidebarSubtitle {
    color: #8A99AD;
    font-size: 10px;
    font-weight: 600;
    padding: 0px 28px 30px 28px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

#separator {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.3 #3B82F6,
        stop:0.7 #3B82F6,
        stop:1 transparent
    );
    min-height: 2px;
    max-height: 2px;
    margin: 0px 20px 30px 20px;
    border: none;
}

/* ============================================================================
   NAVIGATION BUTTONS - Clean Modern Style
   ============================================================================ */
QPushButton#navButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    color: #8A99AD;
    font-size: 14px;
    font-weight: 600;
    padding: 18px 28px;
    margin: 2px 0px;
    text-align: left;
}

QPushButton#navButton:hover {
    background: rgba(59, 130, 246, 0.08);
    color: #FFFFFF;
    border-left: 3px solid #3B82F6;
}

QPushButton#navButton[active="true"] {
    background: rgba(59, 130, 246, 0.12);
    color: #FFFFFF;
    border-left: 3px solid #3B82F6;
}

/* ============================================================================
   LANGUAGE & THEME SWITCHER
   ============================================================================ */
QPushButton#langButton, QPushButton#themeButton {
    background: #1E2235;
    border: 1px solid #2A2F45;
    border-radius: 8px;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 16px;
    letter-spacing: 0.5px;
}

QPushButton#langButton:hover, QPushButton#themeButton:hover {
    background: #252A3F;
    border: 1px solid #3B82F6;
    color: #FFFFFF;
}

QPushButton#langButton[active="true"] {
    background: #3B82F6;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
}

QPushButton#themeButton {
    padding: 8px 12px;
}

/* ============================================================================
   CONTENT AREA - Deep Dark Background
   ============================================================================ */
#contentArea {
    background: #0D0E12;
    padding: 0px;
}

#pageTitle {
    color: #FFFFFF;
    font-size: 42px;
    font-weight: 900;
    margin-bottom: 8px;
    letter-spacing: -1.5px;
}

#pageSubtitle {
    color: #94A3B8;
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 40px;
    letter-spacing: 0.2px;
}

/* ============================================================================
   CARDS - Elevated Dark Surfaces
   ============================================================================ */
QFrame#card {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 16px;
    padding: 28px;
}

QFrame#card:hover {
    border: 1px solid #2A2F45;
}

QLabel#cardTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
}

QLabel#cardSubtitle {
    color: #8A99AD;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 16px;
}

/* ============================================================================
   STAT CARDS - Modern Gradient Accents
   ============================================================================ */
QFrame#statCard {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 16px;
    padding: 24px;
}

QFrame#statCard:hover {
    background: #1A1E2E;
    border: 1px solid #2A2F45;
}

/* ============================================================================
   BUTTONS - Modern SaaS Style
   ============================================================================ */

/* Primary Button - Electric Blue */
QPushButton#primaryButton {
    background: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    padding: 18px 36px;
    letter-spacing: 0.3px;
}

QPushButton#primaryButton:hover {
    background: #2563EB;
}

QPushButton#primaryButton:pressed {
    background: #1D4ED8;
}

/* Success Button - Green */
QPushButton#successButton {
    background: #10B981;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    padding: 16px 32px;
}

QPushButton#successButton:hover {
    background: #059669;
}

QPushButton#successButton:pressed {
    background: #047857;
}

/* Danger Button - Elegant Red */
QPushButton#dangerButton {
    background: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    padding: 16px 32px;
}

QPushButton#dangerButton:hover {
    background: #DC2626;
}

QPushButton#dangerButton:pressed {
    background: #B91C1C;
}

/* Secondary Button - Outline Style */
QPushButton#secondaryButton {
    background: transparent;
    border: 2px solid #334155;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    padding: 14px 30px;
}

QPushButton#secondaryButton:hover {
    background: rgba(51, 65, 85, 0.15);
    border: 2px solid #475569;
    color: #FFFFFF;
}

QPushButton#secondaryButton:pressed {
    background: rgba(51, 65, 85, 0.25);
}

/* Print Button - Compact */
QPushButton#printButton {
    background: #10B981;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 16px;
}

QPushButton#printButton:hover {
    background: #059669;
}

QPushButton:disabled {
    background: #1E2235;
    color: #475569;
    border: none;
}

/* ============================================================================
   INPUT FIELDS - Clean Modern
   ============================================================================ */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #161925;
    border: 2px solid #1E2235;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    padding: 14px 18px;
    selection-background-color: rgba(59, 130, 246, 0.3);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3B82F6;
    background: #1A1E2E;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border: 2px solid #2A2F45;
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: #475569;
}

/* ============================================================================
   COMBOBOX - Modern Dropdown
   ============================================================================ */
QComboBox {
    background: #161925;
    border: 2px solid #1E2235;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    padding: 14px 18px;
    min-width: 220px;
}

QComboBox:hover {
    border: 2px solid #2A2F45;
}

QComboBox:focus {
    border: 2px solid #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 40px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid #94A3B8;
    margin-right: 14px;
}

QComboBox::down-arrow:hover {
    border-top: 7px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background: #161925;
    border: 2px solid #1E2235;
    border-radius: 10px;
    color: #FFFFFF;
    selection-background-color: #3B82F6;
    padding: 8px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 12px 16px;
    border-radius: 6px;
    margin: 2px 4px;
}

QComboBox QAbstractItemView::item:hover {
    background: #1E2235;
}

/* ============================================================================
   SCROLLBAR - Minimal Modern
   ============================================================================ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #2A2F45;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #334155;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #2A2F45;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #334155;
}

/* ============================================================================
   TABLE - Clean Flat Design
   ============================================================================ */
QTableWidget {
    background: #0F111A;
    alternate-background-color: #161925;
    border: 1px solid #1E2235;
    border-radius: 12px;
    color: #FFFFFF;
    gridline-color: #1E2235;
    selection-background-color: rgba(59, 130, 246, 0.2);
    font-size: 13px;
}

QTableWidget::item {
    padding: 14px 12px;
    border: none;
    border-bottom: 1px solid #1E2235;
}

QTableWidget::item:hover {
    background: #161925;
}

QTableWidget::item:selected {
    background: rgba(59, 130, 246, 0.15);
    color: #FFFFFF;
}

QHeaderView::section {
    background: #0F111A;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 16px 12px;
    border: none;
    border-bottom: 2px solid #3B82F6;
    border-right: 1px solid #1E2235;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
    border-right: none;
}

QHeaderView::section:hover {
    background: #161925;
}

/* ============================================================================
   PROGRESS BAR - Modern Gradient
   ============================================================================ */
QProgressBar {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 8px;
    height: 20px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #3B82F6,
        stop:1 #2563EB
    );
    border-radius: 8px;
}

/* ============================================================================
   CHECKBOX & RADIO - Modern Style
   ============================================================================ */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 500;
    spacing: 12px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #2A2F45;
    border-radius: 6px;
    background: #161925;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 2px solid #3B82F6;
    background: #1A1E2E;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #3B82F6;
    border: 2px solid #3B82F6;
}

QRadioButton::indicator {
    border-radius: 11px;
}

/* ============================================================================
   TAB WIDGET - Modern Tabs
   ============================================================================ */
QTabWidget::pane {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 12px;
    padding: 12px;
}

QTabBar::tab {
    background: transparent;
    color: #8A99AD;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QTabBar::tab:hover {
    color: #FFFFFF;
    background: rgba(59, 130, 246, 0.05);
    border-bottom: 3px solid #475569;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 3px solid #3B82F6;
}

/* ============================================================================
   TOOLTIP - Clean Modern
   ============================================================================ */
QToolTip {
    background: #1E2235;
    color: #FFFFFF;
    border: 1px solid #2A2F45;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 600;
}

/* ============================================================================
   STATUS LABELS
   ============================================================================ */
QLabel#statusSuccess {
    color: #10B981;
    font-weight: 700;
}

QLabel#statusWarning {
    color: #F59E0B;
    font-weight: 700;
}

QLabel#statusError {
    color: #EF4444;
    font-weight: 700;
}

QLabel#statusInfo {
    color: #3B82F6;
    font-weight: 700;
}

/* ============================================================================
   MENU & MENUBAR
   ============================================================================ */
QMenuBar {
    background: #0F111A;
    color: #FFFFFF;
    border-bottom: 1px solid #1E2235;
    padding: 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 10px 18px;
    border-radius: 6px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background: #161925;
}

QMenu {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 10px;
    padding: 8px;
}

QMenu::item {
    padding: 12px 24px;
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 500;
}

QMenu::item:selected {
    background: #3B82F6;
}

/* ============================================================================
   SPECIAL COMPONENTS
   ============================================================================ */

/* Glow Card - Dropzone */
#glowCard {
    background: #161925;
    border: 2px dashed #2A2F45;
    border-radius: 16px;
}

#glowCard:hover {
    border: 2px dashed #3B82F6;
    background: #1A1E2E;
}

/* Accent Border */
#accentBorder {
    border-left: 4px solid #3B82F6;
}
