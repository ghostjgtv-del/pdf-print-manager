/* ============================================================================
   PDF Print Manager - ULTIMATE SAAS DARK V2
   Zero-Scroll Professional Design
   Author: Eng. Justo Torres
   ============================================================================ */

* {
    font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    outline: none;
}

QMainWindow {
    background: #0A0B10;
}

/* ============================================================================
   SIDEBAR - Clean & Minimal
   ============================================================================ */
#sidebar {
    background: #0F111A;
    border: none;
    border-right: 1px solid #1E2235;
    min-width: 320px;
    max-width: 320px;
}

/* Logo Container with radial gradient for contrast - Sidebar */
QFrame#logoContainer {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1A1D2E,
        stop:0.3 #D1D5DB,
        stop:0.7 #E5E7EB,
        stop:1 #1A1D2E
    );
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0px 16px 16px 16px;
}

/* Logo Container for About Page */
QFrame#logoContainerAbout {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1E2235,
        stop:0.25 #CBD5E1,
        stop:0.5 #E5E7EB,
        stop:0.75 #CBD5E1,
        stop:1 #1E2235
    );
    border-radius: 16px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    margin: 8px auto;
}

#sidebarTitle {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: 900;
    padding: 36px 24px 4px 24px;
    letter-spacing: -1px;
}

#sidebarSubtitle {
    color: #8A99AD;
    font-size: 10px;
    font-weight: 600;
    padding: 0px 24px 24px 24px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
}

#separator {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.3 #2563EB,
        stop:0.7 #2563EB,
        stop:1 transparent
    );
    min-height: 2px;
    max-height: 2px;
    margin: 0px 16px 24px 16px;
    border: none;
}

/* ============================================================================
   NAVIGATION - Clean Flat
   ============================================================================ */
QPushButton#navButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #8A99AD;
    font-size: 13px;
    font-weight: 600;
    padding: 16px 24px;
    margin: 1px 0px;
    text-align: left;
}

QPushButton#navButton:hover {
    background: rgba(37, 99, 235, 0.08);
    color: #FFFFFF;
    border-left: 3px solid #2563EB;
}

QPushButton#navButton[active="true"] {
    background: rgba(37, 99, 235, 0.12);
    color: #FFFFFF;
    border-left: 3px solid #2563EB;
}

/* ============================================================================
   CONTROLS - Language & Theme
   ============================================================================ */
QPushButton#langButton, QPushButton#themeButton {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 700;
    padding: 7px 14px;
}

QPushButton#langButton:hover, QPushButton#themeButton:hover {
    background: #1E2235;
    border: 1px solid #2563EB;
    color: #FFFFFF;
}

QPushButton#langButton[active="true"] {
    background: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}

/* ============================================================================
   CONTENT AREA - Deep Black
   ============================================================================ */
#contentArea {
    background: #0A0B10;
}

#pageTitle {
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.8px;
}

#pageSubtitle {
    color: #94A3B8;
    font-size: 12px;
    font-weight: 500;
}

#cardTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

#cardLabel {
    color: #94A3B8;
    font-size: 14px;
    font-weight: 600;
}

#cardDescription {
    color: #94A3B8;
    font-size: 13px;
}

/* ============================================================================
   STAT CARDS - Compact & Modern
   ============================================================================ */
QFrame#statCard {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 8px;
}

QFrame#statCard:hover {
    background: #1A1E2E;
    border: 1px solid #252A3F;
}

/* ============================================================================
   MAIN CARD - Expandable Container
   ============================================================================ */
QFrame#mainCard {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 8px;
}

/* ============================================================================
   DROP ZONE - Clean Dashed Border
   ============================================================================ */
QFrame#dropZone {
    background: transparent;
    border: 1px dashed #3B4261;
    border-radius: 6px;
}

QFrame#dropZone:hover {
    border: 1px dashed #2563EB;
    background: rgba(37, 99, 235, 0.03);
}

/* ============================================================================
   BUTTONS - Refined SaaS Style
   ============================================================================ */
QPushButton#primaryButton {
    background: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 24px;
}

QPushButton#primaryButton:hover {
    background: #1D4ED8;
}

QPushButton#primaryButton:pressed {
    background: #1E40AF;
}

QPushButton#successButton {
    background: #10B981;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 24px;
}

QPushButton#successButton:hover {
    background: #059669;
}

QPushButton#dangerButton {
    background: #DC2626;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 24px;
}

QPushButton#dangerButton:hover {
    background: #B91C1C;
}

QPushButton#secondaryButton {
    background: transparent;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 11px 23px;
}

QPushButton#secondaryButton:hover {
    background: rgba(51, 65, 85, 0.15);
    border: 1px solid #475569;
}

QPushButton#printButton {
    background: #2563EB;
    border: 2px solid #1E40AF;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    padding: 0px;
    text-align: center;
    line-height: 1.0;
}

QPushButton#printButton:hover {
    background: #1D4ED8;
    border: 2px solid #1E3A8A;
}

/* ============================================================================
   COMBOBOX - Clean Modern
   ============================================================================ */
QComboBox {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 10px 14px;
}

QComboBox:hover {
    border: 1px solid #252A3F;
}

QComboBox:focus {
    border: 1px solid #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 32px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #94A3B8;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 6px;
    color: #FFFFFF;
    selection-background-color: #2563EB;
    padding: 6px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    border-radius: 4px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background: #1E2235;
}

/* ============================================================================
   TABLE - Professional Data Grid
   ============================================================================ */
QTableWidget {
    background: #0F111A;
    alternate-background-color: #161925;
    border: none;
    border-radius: 0px;
    color: #FFFFFF;
    gridline-color: #1E2235;
    selection-background-color: rgba(37, 99, 235, 0.15);
    font-size: 13px;
}

QTableWidget::item {
    padding: 12px 10px;
    border: none;
    border-bottom: 1px solid #1E2235;
}

QTableWidget::item:hover {
    background: rgba(37, 99, 235, 0.06);
}

QTableWidget::item:selected {
    background: rgba(37, 99, 235, 0.12);
    color: #FFFFFF;
}

QHeaderView::section {
    background: #0F111A;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #2563EB;
    border-right: 1px solid #1E2235;
}

QHeaderView::section:last {
    border-right: none;
}

QHeaderView::section:hover {
    background: #161925;
}

/* ============================================================================
   SCROLLBAR - Minimal
   ============================================================================ */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
}

QScrollBar::handle:vertical {
    background: #252A3F;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #334155;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}

QScrollBar::handle:horizontal {
    background: #252A3F;
    border-radius: 3px;
    min-width: 24px;
}

/* ============================================================================
   PROGRESS BAR
   ============================================================================ */
QProgressBar {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 6px;
    height: 18px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 11px;
}

QProgressBar::chunk {
    background: #2563EB;
    border-radius: 6px;
}

/* ============================================================================
   INPUT FIELDS
   ============================================================================ */
QLineEdit, QTextEdit {
    background: #161925;
    border: 1px solid #1E2235;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 13px;
    padding: 10px 12px;
    selection-background-color: rgba(37, 99, 235, 0.3);
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #2563EB;
}

QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #252A3F;
}

/* ============================================================================
   TOOLTIP
   ============================================================================ */
QToolTip {
    background: #1E2235;
    color: #FFFFFF;
    border: 1px solid #252A3F;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
}

/* ============================================================================
   STATUS LABELS
   ============================================================================ */
QLabel#statusSuccess { color: #10B981; font-weight: 700; }
QLabel#statusWarning { color: #F59E0B; font-weight: 700; }
QLabel#statusError { color: #EF4444; font-weight: 700; }
QLabel#statusInfo { color: #2563EB; font-weight: 700; }
