/* ============================================================================
   PDF Print Manager - ULTIMATE PROFESSIONAL DESIGN
   Premium Commercial-Grade Interface
   Author: Eng. Justo Torres
   ============================================================================ */

/* ============================================================================
   ROOT & MAIN WINDOW
   ============================================================================ */
* {
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
    outline: none;
}

QMainWindow {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0a0d14,
        stop:0.5 #121824,
        stop:1 #0d1117
    );
}

/* ============================================================================
   SIDEBAR - Advanced Glassmorphism with Floating Effect
   ============================================================================ */
#sidebar {
    background: qlineargradient(
        x1:0, y1:0, x2:0.3, y2:1,
        stop:0 rgba(20, 25, 40, 0.98),
        stop:0.4 rgba(15, 20, 35, 0.95),
        stop:1 rgba(10, 15, 25, 0.98)
    );
    border: none;
    border-right: 1px solid qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(100, 181, 246, 0.3),
        stop:0.5 rgba(156, 39, 176, 0.2),
        stop:1 rgba(233, 30, 99, 0.25)
    );
    min-width: 320px;
    max-width: 320px;
}

/* App Title with Gradient Text */
#sidebarTitle {
    color: #ffffff;
    font-size: 34px;
    font-weight: 900;
    padding: 40px 28px 6px 28px;
    letter-spacing: -1px;
}

#sidebarSubtitle {
    color: rgba(176, 184, 196, 0.7);
    font-size: 10px;
    font-weight: 600;
    padding: 0px 28px 30px 28px;
    letter-spacing: 2px;
    text-transform: uppercase;
}

#separator {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 transparent,
        stop:0.1 rgba(100, 181, 246, 0.5),
        stop:0.5 rgba(156, 39, 176, 0.6),
        stop:0.9 rgba(233, 30, 99, 0.5),
        stop:1 transparent
    );
    min-height: 2px;
    max-height: 2px;
    margin: 0px 20px 30px 20px;
    border: none;
}

/* ============================================================================
   NAVIGATION BUTTONS - Ultra Modern with Glow Effects
   ============================================================================ */
QPushButton#navButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    color: rgba(176, 184, 196, 0.85);
    font-size: 14px;
    font-weight: 600;
    padding: 18px 28px;
    margin: 2px 0px;
    text-align: left;
}

QPushButton#navButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.08),
        stop:1 transparent
    );
    color: #ffffff;
    border-left: 3px solid rgba(100, 181, 246, 0.6);
}

QPushButton#navButton[active="true"] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.15),
        stop:0.8 rgba(156, 39, 176, 0.05),
        stop:1 transparent
    );
    color: #ffffff;
    border-left: 3px solid qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #64b5f6,
        stop:1 #9c27b0
    );
}

/* ============================================================================
   LANGUAGE SWITCHER - Premium Pill Design
   ============================================================================ */
QPushButton#langButton {
    background: rgba(30, 35, 50, 0.5);
    border: 1px solid rgba(60, 70, 90, 0.6);
    border-radius: 16px;
    color: rgba(176, 184, 196, 0.8);
    font-size: 11px;
    font-weight: 700;
    padding: 8px 16px;
    letter-spacing: 0.5px;
}

QPushButton#langButton:hover {
    background: rgba(45, 53, 72, 0.7);
    border: 1px solid rgba(100, 181, 246, 0.5);
    color: #ffffff;
}

QPushButton#langButton[active="true"] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.8),
        stop:1 rgba(156, 39, 176, 0.6)
    );
    color: #ffffff;
    border: 1px solid rgba(100, 181, 246, 0.8);
}

/* ============================================================================
   CONTENT AREA
   ============================================================================ */
#contentArea {
    background: transparent;
    padding: 0px;
}

#pageTitle {
    color: #ffffff;
    font-size: 42px;
    font-weight: 900;
    margin-bottom: 8px;
    letter-spacing: -1.5px;
}

#pageSubtitle {
    color: rgba(176, 184, 196, 0.8);
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 40px;
    letter-spacing: 0.2px;
}

/* ============================================================================
   CARDS - Premium Elevated Design with Glow
   ============================================================================ */
QFrame#card {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(25, 30, 45, 0.95),
        stop:1 rgba(20, 25, 40, 0.92)
    );
    border: 1px solid rgba(60, 70, 90, 0.6);
    border-radius: 20px;
    padding: 28px;
}

QFrame#card:hover {
    border: 1px solid rgba(100, 181, 246, 0.4);
}

QLabel#cardTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
}

QLabel#cardSubtitle {
    color: rgba(176, 184, 196, 0.75);
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 18px;
}

/* ============================================================================
   STAT CARDS - Special Premium Design
   ============================================================================ */
QFrame#statCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(30, 136, 229, 0.08),
        stop:1 rgba(156, 39, 176, 0.05)
    );
    border: 1px solid rgba(100, 181, 246, 0.25);
    border-radius: 20px;
    padding: 24px;
}

QFrame#statCard:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(30, 136, 229, 0.12),
        stop:1 rgba(156, 39, 176, 0.08)
    );
    border: 1px solid rgba(100, 181, 246, 0.4);
}

/* ============================================================================
   BUTTONS - Premium with Multiple Variants
   ============================================================================ */
QPushButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1e88e5,
        stop:1 #1565c0
    );
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    padding: 16px 32px;
    letter-spacing: 0.3px;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2196f3,
        stop:1 #1976d2
    );
}

QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1565c0,
        stop:1 #0d47a1
    );
}

QPushButton:disabled {
    background: rgba(45, 53, 72, 0.5);
    color: rgba(107, 114, 128, 0.6);
}

/* Primary Button - Gradient with Glow */
QPushButton#primaryButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2196f3,
        stop:0.5 #1e88e5,
        stop:1 #1976d2
    );
    border: 1px solid rgba(100, 181, 246, 0.3);
    font-size: 15px;
    padding: 18px 36px;
    font-weight: 800;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #42a5f5,
        stop:0.5 #2196f3,
        stop:1 #1e88e5
    );
    border: 1px solid rgba(100, 181, 246, 0.6);
}

/* Success Button - Green Gradient */
QPushButton#successButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #10b981,
        stop:0.5 #059669,
        stop:1 #047857
    );
    border: 1px solid rgba(16, 185, 129, 0.3);
}

QPushButton#successButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #34d399,
        stop:0.5 #10b981,
        stop:1 #059669
    );
    border: 1px solid rgba(16, 185, 129, 0.6);
}

/* Danger Button - Red Gradient */
QPushButton#dangerButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #ef4444,
        stop:0.5 #dc2626,
        stop:1 #b91c1c
    );
    border: 1px solid rgba(239, 68, 68, 0.3);
}

QPushButton#dangerButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #f87171,
        stop:0.5 #ef4444,
        stop:1 #dc2626
    );
    border: 1px solid rgba(239, 68, 68, 0.6);
}

/* Secondary Button - Outlined Premium */
QPushButton#secondaryButton {
    background: rgba(30, 35, 50, 0.5);
    border: 2px solid rgba(60, 70, 90, 0.8);
    color: rgba(176, 184, 196, 0.95);
}

QPushButton#secondaryButton:hover {
    background: rgba(45, 53, 72, 0.7);
    border: 2px solid rgba(100, 181, 246, 0.5);
    color: #ffffff;
}

/* ============================================================================
   INPUT FIELDS - Modern Premium Style
   ============================================================================ */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: rgba(30, 35, 50, 0.6);
    border: 2px solid rgba(60, 70, 90, 0.6);
    border-radius: 12px;
    color: #ffffff;
    font-size: 14px;
    padding: 14px 18px;
    selection-background-color: rgba(30, 136, 229, 0.4);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid rgba(100, 181, 246, 0.7);
    background: rgba(35, 40, 60, 0.8);
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border: 2px solid rgba(80, 90, 110, 0.7);
}

QLineEdit::placeholder, QTextEdit::placeholder {
    color: rgba(107, 114, 128, 0.6);
}

/* ============================================================================
   COMBOBOX - Premium Dropdown
   ============================================================================ */
QComboBox {
    background: rgba(30, 35, 50, 0.6);
    border: 2px solid rgba(60, 70, 90, 0.6);
    border-radius: 12px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    padding: 14px 18px;
    min-width: 220px;
}

QComboBox:hover {
    border: 2px solid rgba(80, 90, 110, 0.7);
}

QComboBox:focus {
    border: 2px solid rgba(100, 181, 246, 0.7);
}

QComboBox::drop-down {
    border: none;
    width: 40px;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid rgba(176, 184, 196, 0.8);
    margin-right: 14px;
}

QComboBox::down-arrow:hover {
    border-top: 7px solid #ffffff;
}

QComboBox QAbstractItemView {
    background: rgba(25, 30, 45, 0.98);
    border: 2px solid rgba(60, 70, 90, 0.8);
    border-radius: 12px;
    color: #ffffff;
    selection-background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.6),
        stop:1 rgba(156, 39, 176, 0.4)
    );
    padding: 8px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 2px 4px;
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(45, 53, 72, 0.7);
}

/* ============================================================================
   SCROLLBAR - Ultra Thin Modern Design
   ============================================================================ */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(100, 181, 246, 0.3);
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(100, 181, 246, 0.5);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: rgba(100, 181, 246, 0.3);
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(100, 181, 246, 0.5);
}

/* ============================================================================
   TABLE - Premium Data Grid
   ============================================================================ */
QTableWidget {
    background: rgba(20, 25, 40, 0.5);
    alternate-background-color: rgba(25, 30, 45, 0.5);
    border: 1px solid rgba(60, 70, 90, 0.5);
    border-radius: 16px;
    color: #ffffff;
    gridline-color: rgba(60, 70, 90, 0.3);
    selection-background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.3),
        stop:1 rgba(156, 39, 176, 0.2)
    );
    font-size: 13px;
}

QTableWidget::item {
    padding: 14px 12px;
    border: none;
    border-bottom: 1px solid rgba(60, 70, 90, 0.2);
}

QTableWidget::item:hover {
    background: rgba(45, 53, 72, 0.4);
}

QTableWidget::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.4),
        stop:1 rgba(156, 39, 176, 0.3)
    );
    color: #ffffff;
}

QHeaderView::section {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.15),
        stop:0.5 rgba(156, 39, 176, 0.1),
        stop:1 rgba(233, 30, 99, 0.12)
    );
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    padding: 16px 12px;
    border: none;
    border-bottom: 2px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(100, 181, 246, 0.6),
        stop:0.5 rgba(156, 39, 176, 0.5),
        stop:1 rgba(233, 30, 99, 0.5)
    );
    border-right: 1px solid rgba(60, 70, 90, 0.3);
}

QHeaderView::section:first {
    border-top-left-radius: 16px;
}

QHeaderView::section:last {
    border-top-right-radius: 16px;
    border-right: none;
}

QHeaderView::section:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.25),
        stop:0.5 rgba(156, 39, 176, 0.18),
        stop:1 rgba(233, 30, 99, 0.2)
    );
}

/* ============================================================================
   PROGRESS BAR - Animated Gradient
   ============================================================================ */
QProgressBar {
    background: rgba(30, 35, 50, 0.6);
    border: 1px solid rgba(60, 70, 90, 0.5);
    border-radius: 10px;
    height: 20px;
    text-align: center;
    color: #ffffff;
    font-weight: 700;
    font-size: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2196f3,
        stop:0.5 #9c27b0,
        stop:1 #e91e63
    );
    border-radius: 10px;
}

/* ============================================================================
   CHECKBOX & RADIO - Modern Premium Style
   ============================================================================ */
QCheckBox, QRadioButton {
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    spacing: 12px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid rgba(60, 70, 90, 0.7);
    border-radius: 7px;
    background: rgba(30, 35, 50, 0.6);
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 2px solid rgba(100, 181, 246, 0.6);
    background: rgba(35, 40, 60, 0.7);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #2196f3,
        stop:1 #9c27b0
    );
    border: 2px solid rgba(100, 181, 246, 0.8);
}

QRadioButton::indicator {
    border-radius: 11px;
}

/* ============================================================================
   TAB WIDGET - Modern Tabs
   ============================================================================ */
QTabWidget::pane {
    background: rgba(20, 25, 40, 0.5);
    border: 1px solid rgba(60, 70, 90, 0.5);
    border-radius: 16px;
    padding: 12px;
}

QTabBar::tab {
    background: transparent;
    color: rgba(176, 184, 196, 0.8);
    border: none;
    border-bottom: 3px solid transparent;
    padding: 14px 28px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QTabBar::tab:hover {
    color: #ffffff;
    background: rgba(45, 53, 72, 0.3);
    border-bottom: 3px solid rgba(100, 181, 246, 0.4);
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 3px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #64b5f6,
        stop:1 #9c27b0
    );
}

/* ============================================================================
   TOOLTIP - Premium Style
   ============================================================================ */
QToolTip {
    background: rgba(25, 30, 45, 0.98);
    color: #ffffff;
    border: 1px solid rgba(100, 181, 246, 0.4);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 600;
}

/* ============================================================================
   STATUS LABELS - Color Coded
   ============================================================================ */
QLabel#statusSuccess {
    color: #10b981;
    font-weight: 700;
}

QLabel#statusWarning {
    color: #f59e0b;
    font-weight: 700;
}

QLabel#statusError {
    color: #ef4444;
    font-weight: 700;
}

QLabel#statusInfo {
    color: #3b82f6;
    font-weight: 700;
}

/* ============================================================================
   MENU & MENUBAR - Premium Dropdown
   ============================================================================ */
QMenuBar {
    background: rgba(20, 25, 40, 0.95);
    color: #ffffff;
    border-bottom: 1px solid rgba(60, 70, 90, 0.6);
    padding: 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 10px 18px;
    border-radius: 8px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background: rgba(45, 53, 72, 0.7);
}

QMenu {
    background: rgba(25, 30, 45, 0.98);
    border: 1px solid rgba(60, 70, 90, 0.8);
    border-radius: 12px;
    padding: 10px;
}

QMenu::item {
    padding: 12px 24px;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 500;
}

QMenu::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 136, 229, 0.5),
        stop:1 rgba(156, 39, 176, 0.3)
    );
}

/* ============================================================================
   SPECIAL EFFECTS - Glow & Shadows
   ============================================================================ */
#glowCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(30, 136, 229, 0.12),
        stop:1 rgba(156, 39, 176, 0.08)
    );
    border: 1px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(100, 181, 246, 0.5),
        stop:1 rgba(156, 39, 176, 0.4)
    );
    border-radius: 20px;
}

#accentBorder {
    border-left: 4px solid qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #64b5f6,
        stop:0.5 #9c27b0,
        stop:1 #e91e63
    );
}
